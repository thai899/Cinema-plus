# ============================================================
#  Cinema Plus – Environment Variables Template
#  Copy to .env (never commit .env to git!)
#  Set these as system/IDE env vars or use a secrets manager.
# ============================================================

# ── Server ───────────────────────────────────────────────
SERVER_PORT=8081

# ── SQL Server ───────────────────────────────────────────
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=CinemaPlusDB;encrypt=true;trustServerCertificate=true;loginTimeout=30;
DB_USERNAME=sa
DB_PASSWORD=CHANGE_ME

# JPA behaviour  (use 'update' locally, 'validate' in prod)
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false

# ── Redis ────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ── MongoDB ──────────────────────────────────────────────
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=CinemaPlusReviews
MONGO_USERNAME=cinemaUser
MONGO_PASSWORD=CHANGE_ME
MONGO_AUTH_DB=admin
# Or use a full URI (overrides individual fields above):
# MONGO_URI=mongodb://cinemaUser:CHANGE_ME@localhost:27017/CinemaPlusReviews?authSource=admin

# ── Neo4j ────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=CHANGE_ME

# ── JWT ──────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_USE_MIN_64_CHAR_RANDOM_STRING
JWT_EXPIRATION_MS=86400000

# ── Seat Lock ────────────────────────────────────────────
SEAT_LOCK_TTL=300

